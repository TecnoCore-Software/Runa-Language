#/ Strings: concatenation with '+' and ordering.
name = "Runa"
printr("Hello!" + "Welcome!")
printr("Language: " + name)
printr("n=" + 42)          #/ any value joins in its printr form
printr("pi=" + 1.5)
printr("flag=" + true)
printr("abc" < "abd")      #/ ordering is UTF-8 byte order
printr("سارا" < "محمود")
